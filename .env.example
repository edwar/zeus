# ── Base de datos (Neon) ───────────────────────────────────────────────────────
# URL pooled (runtime) y URL directa (migraciones de Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# ── Dominio ────────────────────────────────────────────────────────────────────
# URL pública del sitio, sin barra final. Define canónicas, Open Graph, sitemap y robots.
# Local: http://localhost:3000 · Producción: https://zeus.cognilab.dev
# (Si falta, en producción de Vercel se usa https://zeus.cognilab.dev y en previews la URL del despliegue.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Solo producción se indexa. Pon 1 únicamente si quieres que otro entorno (p. ej. staging) sea indexable.
NEXT_PUBLIC_SITE_INDEXABLE=""

# ── Autenticación (Better Auth) ────────────────────────────────────────────────
# secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Debe ser el dominio real donde se sirve la app: https://zeus.cognilab.dev en producción
BETTER_AUTH_URL="http://localhost:3000"

# ── Tareas programadas ─────────────────────────────────────────────────────────
# Cron de sincronización con Autosolar (Vercel lo envía como Authorization: Bearer)
CRON_SECRET=""

# ── Límites de uso ─────────────────────────────────────────────────────────────
# Sal para el hash de IP del límite de uso (si falta, se usa BETTER_AUTH_SECRET)
RATE_LIMIT_SALT=""
# Tope diario global de extracciones de facturas con IA (cuida el costo). Opcional.
EXTRACT_DAILY_CAP=""

# ── Imágenes de productos (S3-compatible: Neon Object Storage, R2, S3…) ────────
# El bucket debe ser de lectura pública. STORAGE_PUBLIC_URL es la base pública de las imágenes (también para el CSP).
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="product-images"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ── IA (lectura de facturas) ───────────────────────────────────────────────────
# En Vercel el AI Gateway autentica solo (OIDC). Localmente: `vercel env pull` o AI_GATEWAY_API_KEY.
# AI_GATEWAY_API_KEY=""

# ── Correo (restablecer contraseña) ────────────────────────────────────────────
# Resend (https://resend.com): clave de API y remitente de un dominio verificado, p. ej. "Zeus <no-reply@cognilab.dev>".
# Sin estas dos, «olvidé mi contraseña» explica que un administrador debe restablecerla (no se envía nada).
RESEND_API_KEY=""
MAIL_FROM=""
