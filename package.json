{
  "name": "zeus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:create-admin": "node --import tsx prisma/create-admin.ts",
    "scrape": "node --import tsx prisma/scrape-autosolar.ts",
    "db:classify": "node --import tsx prisma/classify-products.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "db:migrate-images": "node --import tsx prisma/migrate-images.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "legal:check": "node --import tsx scripts/legal-check.ts",
    "videos": "playwright test -c playwright.videos.config.ts && node scripts/encode-videos.mjs",
    "videos:encode": "node scripts/encode-videos.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
